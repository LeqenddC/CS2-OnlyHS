<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CS2-OnlyHS</AssemblyName>
    <RootNamespace>OnlyHS</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.373" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
